rules_version = '2';

// =====================================================================
// ProfAssistant — Règles Firestore communes V1 + V2 (Phase 0 de la fusion)
// ---------------------------------------------------------------------
// Principes :
//  - Les Cloud Functions (Admin SDK) contournent ces règles : corrigerDevoir,
//    interrogerTuteur, etc. ne sont pas concernées.
//  - Un élève Google (V1) ne lit/écrit que SES documents (clé = email).
//  - Un élève Google (V2) ne lit/écrit que SA progression (propriété = email vérifié),
//    sans pouvoir toucher aux champs réservés au professeur.
//  - Tout le reste est réservé aux enseignants.
//  - Tests : tests/firestore/rules.test.mjs
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Identité ----------
    function signedIn() {
      return request.auth != null;
    }

    function isGoogleUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isTeacher() {
      return signedIn() && (
        request.auth.token.get('role', '') in ['enseignant', 'admin'] ||
        request.auth.token.get('admin', false) == true ||
        (isGoogleUser() && (
          myEmail() == 'gatweb@gmail.com' ||
          (exists(/databases/$(database)/documents/enseignants/$(myEmail())) &&
           get(/databases/$(database)/documents/enseignants/$(myEmail())).data.get('actif', true) == true)
        ))
      );
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('role', '') == 'admin' ||
        request.auth.token.get('admin', false) == true ||
        (isGoogleUser() && (
          myEmail() == 'gatweb@gmail.com' ||
          (exists(/databases/$(database)/documents/enseignants/$(myEmail())) &&
           get(/databases/$(database)/documents/enseignants/$(myEmail())).data.get('role', '') == 'admin' &&
           get(/databases/$(database)/documents/enseignants/$(myEmail())).data.get('actif', true) == true)
        ))
      );
    }

    // ---------- Référentiel public (lecture seule pour les élèves) ----------
    match /config/{docId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isTeacher();

      match /modules/{moduleId} {
        allow read: if true;
        allow write: if isTeacher();
      }
    }

    match /cours/{courseId} {
      allow read: if true;
      allow write: if isTeacher();

      match /modules/{moduleId} {
        allow read: if true;
        allow write: if isTeacher();
      }
    }

    match /exercices/{exId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    match /config_presentations/{moduleId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // ---------- Annuaires ----------
    match /enseignants/{profId} {
      allow read: if isTeacher();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      // Un élève Google peut lire sa propre fiche :
      //  - clé = email (V1), ou
      //  - fiche V2 `st_<email>` dont le champ `email` est le sien (classe officielle).
      // `resource == null` : lecture d'une fiche inexistante, sans fuite de données.
      allow read: if isTeacher()
        || (isGoogleUser() && (
             userId.lower() == myEmail()
             || resource == null
             || resource.data.get('email', '') == myEmail()));
      allow write: if isTeacher();
    }

    match /classes/{classeId} {
      allow read: if signedIn();
      allow write: if isTeacher();

      match /eleves/{eleveId} {
        allow read, write: if isTeacher();
      }
    }

    // ---------- V1 : progression par cours (clé = email_coursId) ----------
    match /users_progress/{docId} {
      // resource == null : lecture d'un document inexistant (1re visite), sans fuite.
      allow read: if isTeacher()
        || (isGoogleUser() && (resource == null || resource.data.email.lower() == myEmail()));
      allow create: if isGoogleUser() && request.resource.data.email.lower() == myEmail();
      allow update: if isTeacher()
        || (isGoogleUser()
            && resource.data.email.lower() == myEmail()
            && request.resource.data.email.lower() == myEmail());
      allow delete: if isTeacher();
    }

    // ---------- V1 : résultats d'examen ----------
    match /exam_results/{resId} {
      allow read: if isTeacher()
        || (isGoogleUser() && resource.data.email_eleve.lower() == myEmail());
      allow create: if isGoogleUser() && request.resource.data.email_eleve.lower() == myEmail();
      allow update, delete: if isTeacher();
    }

    // ---------- V1 + V2 : soumissions de devoirs ----------
    function ownsSubmission(data) {
      return (isGoogleUser() && data.get('email_eleve', '').lower() == myEmail())
        || (signedIn() && data.get('uid_eleve', '') == request.auth.uid);
    }

    match /submissions/{subId} {
      allow read: if isTeacher() || ownsSubmission(resource.data);

      // Un élève ne peut créer qu'une copie à son nom, en attente de validation :
      // jamais déjà validée/publiée, jamais avec une note prof ni le marqueur
      // `ia_evaluated` (posé uniquement par la Cloud Function corrigerDevoir).
      allow create: if isTeacher()
        || (ownsSubmission(request.resource.data)
            && request.resource.data.get('status', 'brouillon') in ['brouillon', 'a_valider', 'pending']
            && !request.resource.data.keys().hasAny(['note', 'prof_message', 'ia_evaluated']));

      // L'élève ne peut mettre à jour que les compteurs d'autonomie / d'indices.
      allow update: if isTeacher()
        || (ownsSubmission(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['autonomie', 'indices_utilises', 'questions_libres']));

      allow delete: if isTeacher();
    }

    // ---------- V1 : file d'envoi d'emails (extension Trigger Email) ----------
    match /mail_queue/{mailId} {
      // Un élève ne peut s'envoyer un email qu'à lui-même.
      allow create: if isTeacher()
        || (isGoogleUser() && request.resource.data.to.lower() == myEmail());
      allow read, update, delete: if isTeacher();
    }

    // ---------- V2 : progression élève (clé = <classe>_<email assaini>) ----------
    // Propriété = adresse e-mail Google vérifiée (plus de reprise des documents sans `uid`,
    // plus d'écriture par les sessions anonymes : le mode invité reste 100 % local).
    function myProgressionKey() {
      return myEmail().replace('[^a-zA-Z0-9_-]', '_');
    }

    function isMyProgressionId(docId) {
      return docId.matches('^[A-Za-z0-9-]+_' + myProgressionKey() + '$');
    }

    function ownsProgression(docId, data) {
      return isGoogleUser() && (
        data.get('eleve_email', '') == myEmail()
        || (data.get('eleve_email', '') == '' && isMyProgressionId(docId))
      );
    }

    // Champs réservés au professeur : jamais créés ni modifiés par l'élève.
    function teacherOnlyProgressionKeys() {
      return ['manual_completed_courses', 'manual_completed_exos',
              'xp_teacher_override', 'xp_teacher_override_at',
              'bulletin_appreciation', 'bulletin_custom_note20', 'bulletin_updated_at',
              'archived', 'status', 'school_year'];
    }

    function validXp(data) {
      return data.get('xp', 0) is number && data.get('xp', 0) >= 0 && data.get('xp', 0) <= 100000;
    }

    match /progressions_v2/{docId} {
      allow read: if isTeacher()
        || (signedIn() && resource == null)
        || (signedIn() && resource.data.get('uid', '') == request.auth.uid)
        || (isGoogleUser() && resource.data.get('eleve_email', '') == myEmail());

      allow create: if isTeacher()
        || (isGoogleUser()
            && isMyProgressionId(docId)
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.eleve_email == myEmail()
            && validXp(request.resource.data)
            && !request.resource.data.keys().hasAny(teacherOnlyProgressionKeys()));

      // L'élève met à jour SA progression, sans toucher aux champs prof,
      // sans jamais faire baisser ses XP ni retirer une activité déjà récompensée
      // (protège aussi contre l'écrasement par un appareil non synchronisé).
      allow update: if isTeacher()
        || (ownsProgression(docId, resource.data)
            && request.resource.data.eleve_email == myEmail()
            && validXp(request.resource.data)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(teacherOnlyProgressionKeys())
            && (!(resource.data.get('xp', 0) is number)
                || request.resource.data.get('xp', 0) >= resource.data.get('xp', 0))
            && (!(resource.data.get('rewarded_activities', []) is list)
                || request.resource.data.get('rewarded_activities', [])
                     .hasAll(resource.data.get('rewarded_activities', []))));

      allow delete: if isTeacher();
    }

    // ---------- Phase 7 : Compteurs de quota IA par utilisateur (usage/{uid}) ----------
    match /usage/{uid} {
      // Lecture autorisée pour l'utilisateur concerné ou un enseignant.
      // Écriture strictement réservée aux Cloud Functions (Admin SDK) pour empêcher toute remise à zéro côté client.
      allow read: if isTeacher() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    // ---------- Par défaut : administrateurs pour l'écriture ----------
    match /{document=**} {
      allow read: if isTeacher();
      allow write: if isAdmin();
    }
  }
}
