rules_version = '2';

// =====================================================================
// ProfAssistant — Règles Firestore communes V1 + V2 (Phase 0 de la fusion)
// ---------------------------------------------------------------------
// Principes :
//  - Les Cloud Functions (Admin SDK) contournent ces règles : corrigerDevoir,
//    interrogerTuteur, etc. ne sont pas concernées.
//  - Un élève Google (V1) ne lit/écrit que SES documents (clé = email).
//  - Un élève anonyme (V2) ne lit/écrit que SA progression (clé = uid).
//  - Tout le reste est réservé aux enseignants.
//  - Tests : tests/firestore/rules.test.mjs
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Identité ----------
    function signedIn() {
      return request.auth != null;
    }

    function isGoogleUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isTeacher() {
      return signedIn() && (
        request.auth.token.get('role', '') in ['enseignant', 'admin'] ||
        request.auth.token.get('admin', false) == true ||
        (isGoogleUser() && (
          myEmail() == 'gatweb@gmail.com' ||
          (exists(/databases/$(database)/documents/enseignants/$(myEmail())) &&
           get(/databases/$(database)/documents/enseignants/$(myEmail())).data.get('actif', true) == true)
        ))
      );
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('role', '') == 'admin' ||
        request.auth.token.get('admin', false) == true ||
        (isGoogleUser() && (
          myEmail() == 'gatweb@gmail.com' ||
          (exists(/databases/$(database)/documents/enseignants/$(myEmail())) &&
           get(/databases/$(database)/documents/enseignants/$(myEmail())).data.get('role', '') == 'admin' &&
           get(/databases/$(database)/documents/enseignants/$(myEmail())).data.get('actif', true) == true)
        ))
      );
    }

    // ---------- Référentiel public (lecture seule pour les élèves) ----------
    match /config/{docId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    match /cours/{courseId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    match /exercices/{exId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    match /config_presentations/{moduleId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // ---------- Annuaires ----------
    match /enseignants/{profId} {
      allow read: if isTeacher();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      // Un élève Google peut lire sa propre fiche (clé = email en V1)
      allow read: if isTeacher() || (isGoogleUser() && userId.lower() == myEmail());
      allow write: if isTeacher();
    }

    match /classes/{classeId} {
      allow read: if signedIn();
      allow write: if isTeacher();

      match /eleves/{eleveId} {
        allow read, write: if isTeacher();
      }
    }

    // ---------- V1 : progression par cours (clé = email_coursId) ----------
    match /users_progress/{docId} {
      // resource == null : lecture d'un document inexistant (1re visite), sans fuite.
      allow read: if isTeacher()
        || (isGoogleUser() && (resource == null || resource.data.email.lower() == myEmail()));
      allow create: if isGoogleUser() && request.resource.data.email.lower() == myEmail();
      allow update: if isTeacher()
        || (isGoogleUser()
            && resource.data.email.lower() == myEmail()
            && request.resource.data.email.lower() == myEmail());
      allow delete: if isTeacher();
    }

    // ---------- V1 : résultats d'examen ----------
    match /exam_results/{resId} {
      allow read: if isTeacher()
        || (isGoogleUser() && resource.data.email_eleve.lower() == myEmail());
      allow create: if isGoogleUser() && request.resource.data.email_eleve.lower() == myEmail();
      allow update, delete: if isTeacher();
    }

    // ---------- V1 + V2 : soumissions de devoirs ----------
    function ownsSubmission(data) {
      return (isGoogleUser() && data.get('email_eleve', '').lower() == myEmail())
        || (signedIn() && data.get('uid_eleve', '') == request.auth.uid);
    }

    match /submissions/{subId} {
      allow read: if isTeacher() || ownsSubmission(resource.data);

      // Un élève ne peut créer qu'une copie à son nom, jamais déjà « publiée ».
      allow create: if isTeacher()
        || (ownsSubmission(request.resource.data)
            && request.resource.data.get('status', '') != 'publie');

      // L'élève ne peut mettre à jour que les compteurs d'autonomie / d'indices.
      allow update: if isTeacher()
        || (ownsSubmission(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['autonomie', 'indices_utilises', 'questions_libres']));

      allow delete: if isTeacher();
    }

    // ---------- V1 : file d'envoi d'emails (extension Trigger Email) ----------
    match /mail_queue/{mailId} {
      // Un élève ne peut s'envoyer un email qu'à lui-même.
      allow create: if isTeacher()
        || (isGoogleUser() && request.resource.data.to.lower() == myEmail());
      allow read, update, delete: if isTeacher();
    }

    // ---------- V2 : progression FMTTN (clé = classe_eleveId) ----------
    match /progressions_v2/{docId} {
      allow read: if isTeacher()
        || (signedIn() && (resource == null || resource.data.get('uid', '') == request.auth.uid));

      allow create: if isTeacher()
        || (signedIn() && request.resource.data.uid == request.auth.uid);

      // L'élève met à jour sa propre progression. Les anciens documents sans `uid`
      // (créés avant ce correctif) sont rattachés à la session au 1er enregistrement :
      // leur clé aléatoire n'est pas énumérable (lecture interdite aux autres).
      allow update: if isTeacher()
        || (signedIn()
            && request.resource.data.uid == request.auth.uid
            && (resource.data.get('uid', null) == request.auth.uid
                || !('uid' in resource.data)));

      allow delete: if isTeacher();
    }

    // ---------- Par défaut : administrateurs pour l'écriture ----------
    match /{document=**} {
      allow read: if isTeacher();
      allow write: if isAdmin();
    }
  }
}
